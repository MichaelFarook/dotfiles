# My Aliases
alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'

# Global aliases
alias v='nvim'
alias ..='cd ..'

# Git aliases
alias ga='git add'
alias gc='git commit -m'
alias gp='git pull'

# Kubectl aliases
alias k='kubectl'
alias kd='kubectl describe'
alias kg='kubectl get'
alias kgp='kubectl get pod'
alias kgall='kubectl get all'
alias kdp='kubectl describe pod'
alias kgs='kubectl get service'
alias kgd='kubectl get deployments'
alias ks='kubectl config set-context --current --namespace'

# Client-specific aliases (AWS profiles, cluster contexts, role ARNs) live in an
# untracked, git-ignored aliases.local. Present only where created, so no client
# identifiers travel with the repository.
#
# Both locations are honoured: $ZDOTDIR (~/.config/zsh) is the documented path
# for a new machine, and $DOTFILES/zsh is where older machines keep it. Sourcing
# both means neither layout silently loses its aliases.
for _aliases_local in "$ZDOTDIR/aliases.local" "$DOTFILES/zsh/aliases.local"; do
    [ -f "$_aliases_local" ] && source "$_aliases_local"
done
unset _aliases_local

alias openvpn='openvpn3 session-start --config "client.conf"'
alias spull='git checkout staging && git pull'

export PATH="$HOME/snap/tenv/current/.tenv/bin:$PATH"

alias d='dirs -v'
for index ({1..9}) alias "$index"="cd +${index}"; unset index
